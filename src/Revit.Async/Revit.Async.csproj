<Project Sdk="VolocyNazad.Revit.Sdk/1.0.43">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Kennan Chan;VolocyNazad</Authors>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Copyright>Copyright (c) 2020 Kennan Chan</Copyright>
    <Description>Task-based asynchronous access to the Autodesk Revit API.</Description>
    <PackageTags>autodesk;revit;api;async;external-event</PackageTags>
    <PackageId>VolocyNazad.Revit.Async</PackageId>
    <PackageType>Dependency</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/VolocyNazad/toolkit.revit.async</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/VolocyNazad/toolkit.revit.async</RepositoryUrl>
    <PackageOutputPath>..\..\artifacts\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <Configurations>
      Debug_2021.1.9;Debug_2023.0.0;Debug_2025.0.0;
      Debug_2026.0.0;Debug_2027.0.2;
      Release_2021.1.9;Release_2023.0.0;Release_2025.0.0;
      Release_2026.0.0;Release_2027.0.2
    </Configurations>
  </PropertyGroup>

  <!--
    MinVer вычисляет minor.patch по git-тегам/истории коммитов, major всегда берётся из MajorRevitVersion (задаётся SDK из конфигурации).
    Если HEAD не совпадает с тегом, MinVer сам увеличивает patch и добавляет суффикс "dev.<кол-во коммитов после тега>",
    например: тег "0.0.6" + 4 коммита после него -> patch=7, MinVerPreRelease="dev.4".
  -->
  <PropertyGroup>
    <MinVerTagPrefix></MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <Target Name="ApplyRevitVersion" AfterTargets="MinVer" BeforeTargets="GetAssemblyVersion;GenerateNuspec;CoreCompile">
    <PropertyGroup>
      <!-- AssemblyVersion/FileVersion — только числа (System.Version не поддерживает суффиксы) -->
      <AssemblyVersion>$(MajorRevitVersion).0.$(MinVerPatch)</AssemblyVersion>
      <FileVersion>$(MajorRevitVersion).0.$(MinVerPatch)</FileVersion>

      <!-- Version/PackageVersion — с суффиксом "-dev.N", если сборка не из коммита с тегом -->
      <Version Condition="'$(MinVerPreRelease)' == ''">$(MajorRevitVersion).0.$(MinVerPatch)</Version>
      <Version Condition="'$(MinVerPreRelease)' != ''">$(MajorRevitVersion).0.$(MinVerPatch)-$(MinVerPreRelease)</Version>
      <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitVersion)" PrivateAssets="all" />
    <PackageReference Include="MinVer" Version="6.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
