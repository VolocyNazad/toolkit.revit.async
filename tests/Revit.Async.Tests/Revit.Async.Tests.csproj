<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">

  <PropertyGroup>
    <Platform>x64</Platform>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- Copied 1-to-1 from the main .csproj so that ProjectReference resolves without SetConfiguration -->
  <PropertyGroup>
    <Configurations>
      Debug_2021.1.100;Debug_2022.1.80;Debug_2023.1.90;Debug_2024.3.60;Debug_2025.4.60;Debug_2026.4.10;Debug_2027.3.0;
      Release_2021.1.100;Release_2022.1.80;Release_2023.1.90;Release_2024.3.60;Release_2025.4.60;Release_2026.4.10;Release_2027.3.0
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Revit.Async\Revit.Async.csproj" />
  </ItemGroup>

  <!--
    By default, the SDK strips RevitAPI/RevitAPIUI from the output folder (on the assumption that the host is Revit itself).
    The test process does not run inside Revit, so this copy needs to be restored via a separate target.
  -->
  <Target Name="RestoreRevitApiCopyLocalForTests" AfterTargets="RemoveRevitAPICopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(ReferencePath)" Condition="'%(Filename)' == 'RevitAPI' or '%(Filename)' == 'RevitAPIUI'" />
    </ItemGroup>
  </Target>

</Project>
