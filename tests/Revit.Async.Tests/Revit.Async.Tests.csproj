<Project Sdk="VolocyNazad.Revit.Sdk/1.0.43">

  <PropertyGroup>
    <Platform>x64</Platform>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- Скопировано 1-в-1 из основного .csproj, чтобы ProjectReference резолвился без SetConfiguration -->
  <PropertyGroup>
    <Configurations>
      Debug_2021.1.9;Debug_2023.0.0;Debug_2025.0.0;
      Debug_2026.0.0;Debug_2027.0.2;
      Release_2021.1.9;Release_2023.0.0;Release_2025.0.0;
      Release_2026.0.0;Release_2027.0.2
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Revit.Async\Revit.Async.csproj" />
  </ItemGroup>

  <!--
    SDK по умолчанию вырезает RevitAPI/RevitAPIUI из выходной папки (расчёт на то, что хост — сам Revit).
    Тестовый процесс Revit не запускает, поэтому копирование нужно вернуть отдельным таргетом.
  -->
  <Target Name="RestoreRevitApiCopyLocalForTests" AfterTargets="RemoveRevitAPICopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(ReferencePath)" Condition="'%(Filename)' == 'RevitAPI' or '%(Filename)' == 'RevitAPIUI'" />
    </ItemGroup>
  </Target>

</Project>
